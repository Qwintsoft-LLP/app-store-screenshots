# Application Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Persistent Storage Paths (used by Coolify mounts)
# Host directory on Coolify server
STORAGE_PATH=/data/coolify/applications/app-store-screenshots

# Path to the persistent project state file inside the container
PROJECT_STATE_PATH=/app/storage/app-store-screenshots.json

# Telemetry
NEXT_TELEMETRY_DISABLED=1
